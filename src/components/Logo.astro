---
import { site } from '../data/site';
import { doctorTitles, localeFromPath, localizedPath, translations } from '../data/i18n';

interface Props {
  variant?: 'header' | 'footer';
}

const { variant = 'header' } = Astro.props;
const isHeader = variant === 'header';
const locale = localeFromPath(Astro.url.pathname);
---

<a href={localizedPath(locale, 'home')} class="group flex items-center gap-3" data-header-logo>
  <img
    src={site.logo.icon}
    alt=""
    width="44"
    height="44"
    class="h-10 w-10 shrink-0 object-contain transition-transform duration-300 group-hover:scale-105 sm:h-11 sm:w-11"
    loading={isHeader ? 'eager' : 'lazy'}
    decoding={isHeader ? 'sync' : 'async'}
  />
  <span class="min-w-0">
    <span class="block font-display text-lg leading-none text-ink sm:text-xl">
      {doctorTitles[locale]} {site.shortName.replace('Dra. ', '')}
    </span>
    <span class="mt-1 block text-[0.62rem] uppercase tracking-[0.2em] text-gold-deep sm:text-[0.68rem]">
      {locale === 'pt-BR' ? site.specialtyShort : translations[locale].pages.home.title}
    </span>
  </span>
</a>
