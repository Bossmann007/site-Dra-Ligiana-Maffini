---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandPattern from './BrandPattern.astro';
import { site, languagesNote } from '../data/site';
import { localizedPath, translations, type Locale } from '../data/i18n';
import { onboardingCopy } from '../data/onboarding';

interface Props { locale: Locale }

const { locale } = Astro.props;
const copy = onboardingCopy[locale];
const intro = locale === 'pt-BR'
  ? {
      title: 'Sua primeira consulta com a Dra. Ligiana',
      lead: 'Um guia simples para saber como agendar, onde fica o consultório e o que esperar do primeiro encontro.',
      detail: 'O agendamento e as orientações específicas são confirmados diretamente com o consultório. Este site não recebe dados de pacientes.',
    }
  : translations[locale].pages.firstVisit;
const languages = locale === 'pt-BR' ? languagesNote : translations[locale].ui.consultationLanguages;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${site.mapQuery}`;
---

<BaseLayout title={intro.title} description={intro.lead} path={localizedPath(locale, 'firstVisit')}>
  <section class="hero-glow relative overflow-hidden border-b border-line/70">
    <BrandPattern />
    <div class="container-site relative py-16 md:py-24">
      <div class="max-w-3xl">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1 class="heading-display mt-4 max-w-3xl text-balance">{intro.title}</h1>
        <p class="prose-site mt-6 max-w-2xl">{intro.lead}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={site.whatsapp} class="btn-primary" target="_blank" rel="noopener noreferrer">{copy.book}</a>
          <a href="#passo-a-passo" class="btn-secondary">{copy.explore}</a>
        </div>
      </div>
    </div>
  </section>

  <section id="passo-a-passo" class="container-site max-w-3xl py-16 md:py-24">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 class="heading-section mt-3 max-w-2xl">{copy.stepsTitle}</h2>
    <div class="mt-10 space-y-3">
      {copy.steps.map((step, index) => (
        <details class="card-soft group" name="onboarding-steps" open={index === 0}>
          <summary class="flex cursor-pointer list-none items-center gap-4 [&::-webkit-details-marker]:hidden">
            <span class="font-display text-2xl text-gold-deep" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="flex-1 font-display text-xl text-ink md:text-2xl">{step.title}</h3>
            <span class="text-gold-deep group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="prose-site mt-4 border-t border-line/70 pt-4 text-base">{step.text}</p>
        </details>
      ))}
    </div>
    <details class="card-soft group mt-6">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-xl text-ink [&::-webkit-details-marker]:hidden">
        {copy.prepareTitle}<span class="text-gold-deep group-open:rotate-45" aria-hidden="true">+</span>
      </summary>
      <p class="prose-site mt-4 text-sm">{copy.prepareIntro}</p>
      <ul class="mt-5 space-y-3">
        {copy.prepare.map((item) => (
          <li class="flex gap-3 text-sm leading-relaxed text-ink-soft">
            <span class="text-gold-deep" aria-hidden="true">✓</span><span>{item}</span>
          </li>
        ))}
      </ul>
    </details>
  </section>

  <section class="section-marble border-y border-line/70 py-16 md:py-24">
    <div class="container-site grid max-w-3xl gap-5">
      <details class="card-soft group" name="visit-mode">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-2xl text-ink [&::-webkit-details-marker]:hidden">
          <h2 class="font-display text-2xl text-ink">{copy.locationTitle}</h2><span class="text-gold-deep group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <p class="prose-site mt-3">{copy.locationText}</p>
        <address class="prose-site mt-4 not-italic">{site.address.full}</address>
        <a href={mapLink} class="mt-4 inline-block font-medium text-gold-deep hover:underline" target="_blank" rel="noopener noreferrer">{copy.map} →</a>
      </details>
      <details class="card-soft group" name="visit-mode">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-2xl text-ink [&::-webkit-details-marker]:hidden">
          <h2 class="font-display text-2xl text-ink">{copy.remoteTitle}</h2><span class="text-gold-deep group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <p class="prose-site mt-3">{copy.remoteText}</p>
        <h3 class="mt-6 font-semibold text-ink">{copy.languagesTitle}</h3>
        <p class="prose-site mt-2 text-sm">{languages}</p>
      </details>
    </div>
  </section>

  <section class="container-site max-w-3xl py-16 md:py-24">
    <h2 class="heading-section">{copy.questionsTitle}</h2>
    <div class="mt-8 space-y-3">
      {copy.questions.map((item) => (
        <details class="card-soft group">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-xl text-ink [&::-webkit-details-marker]:hidden">
            {item.question}<span class="text-gold-deep group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="prose-site mt-4">{item.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="section-rose border-t border-line/70 py-16 md:py-20">
    <div class="container-site max-w-3xl text-center">
      <h2 class="heading-section">{copy.contactTitle}</h2>
      <p class="prose-site mx-auto mt-4 max-w-xl">{copy.contactText}</p>
      <p class="prose-site mt-3 text-sm">{intro.detail}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={site.whatsapp} class="btn-primary" target="_blank" rel="noopener noreferrer">{copy.book}</a>
      </div>
    </div>
  </section>
</BaseLayout>
