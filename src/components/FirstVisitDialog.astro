---
import { site, languagesNote } from '../data/site';
import { languageNames, localizedPath, translations, type Locale, type PageId } from '../data/i18n';
import { onboardingCopy } from '../data/onboarding';

interface Props { locale: Locale }

const { locale } = Astro.props;
const copy = onboardingCopy[locale];
const carePages: PageId[] = ['family', 'lifestyle', 'prevention', 'women', 'menopause', 'weight', 'longevity'];
const portugueseCare: Partial<Record<PageId, string>> = {
  family: 'Medicina de Família e Comunidade', lifestyle: copy.lifestyle,
  prevention: 'Prevenção', women: 'Saúde da mulher', menopause: 'Menopausa',
  weight: 'Emagrecimento clínico', longevity: 'Longevidade',
};
const careLabel = (page: PageId) => locale === 'pt-BR' ? portugueseCare[page] : translations[locale].pages[page].title;
const consultationLanguages = locale === 'pt-BR' ? languagesNote : translations[locale].ui.consultationLanguages;
---

<dialog
  id="primeira-consulta"
  class="first-visit-dialog rounded-3xl border border-line bg-surface p-0 text-ink shadow-2xl"
  aria-labelledby="first-visit-title"
  data-first-visit-dialog
  data-whatsapp={site.whatsapp}
  data-message-intro={copy.messageIntro}
  data-message-about={copy.messageAbout}
  data-message-area={copy.messageArea}
>
  <div class="p-6 sm:p-9">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="eyebrow">01 / 04</p>
        <h2 id="first-visit-title" class="font-display mt-2 text-3xl leading-tight sm:text-4xl">{copy.welcome}</h2>
      </div>
      <button type="button" class="flex min-h-11 min-w-11 items-center justify-center rounded-full border border-line text-2xl leading-none hover:bg-gold-soft focus-visible:outline-2 focus-visible:outline-gold" aria-label={copy.close} data-first-visit-close>×</button>
    </div>

    <div class="mt-6 min-h-56">
      <section data-first-visit-step="0">
        <p class="prose-site">{copy.intro}</p>
        <label for="first-visit-language" class="mt-7 block font-medium">{copy.language}</label>
        <select id="first-visit-language" class="mt-2 min-h-11 w-full rounded-xl border border-line bg-surface px-4 text-ink focus-visible:outline-2 focus-visible:outline-gold" data-first-visit-language>
          {(['pt-BR', 'en', 'de', 'it', 'fr', 'es'] as const).map((language) => (
            <option value={`${localizedPath(language, 'home')}#primeira-consulta`} selected={language === locale}>{languageNames[language]}</option>
          ))}
        </select>
      </section>

      <section data-first-visit-step="1" hidden>
        <h3 class="font-display text-2xl" tabindex="-1" data-step-heading>{copy.purpose}</h3>
        <fieldset class="mt-5 space-y-3">
          <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-line p-4 hover:border-gold">
            <input type="radio" name="first-visit-purpose" value="about" class="mt-1 accent-gold" data-first-visit-purpose />
            <span>{copy.about}</span>
          </label>
          <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-line p-4 hover:border-gold">
            <input type="radio" name="first-visit-purpose" value="area" class="mt-1 accent-gold" data-first-visit-purpose />
            <span>{copy.area}</span>
          </label>
        </fieldset>
        <label for="first-visit-area" class="mt-5 block font-medium" data-first-visit-area-label hidden>{copy.areaPlaceholder}</label>
        <select id="first-visit-area" class="mt-2 min-h-11 w-full rounded-xl border border-line bg-surface px-4 text-ink focus-visible:outline-2 focus-visible:outline-gold" data-first-visit-area hidden disabled>
          <option value="">{copy.areaPlaceholder}</option>
          {carePages.map((page) => <option value={page}>{careLabel(page)}</option>)}
        </select>
        <p class="mt-3 text-sm text-ink-soft" role="alert" data-first-visit-error hidden></p>
      </section>

      <section data-first-visit-step="2" hidden>
        <h3 class="font-display text-2xl" tabindex="-1" data-step-heading>{copy.prepareTitle}</h3>
        <p class="prose-site mt-4 text-base">{copy.prepareIntro}</p>
        <ul class="mt-5 space-y-3">
          {copy.prepare.map((item) => <li class="flex gap-3 text-ink-soft"><span aria-hidden="true" class="text-gold-deep">✓</span>{item}</li>)}
        </ul>
        <p class="mt-6 border-t border-line pt-4 text-sm text-ink-soft">{consultationLanguages}</p>
      </section>

      <section data-first-visit-step="3" hidden>
        <h3 class="font-display text-2xl" tabindex="-1" data-step-heading>{copy.contactTitle}</h3>
        <p class="prose-site mt-3 text-base">{copy.contactIntro}</p>
        <p class="mt-6 text-sm font-semibold text-ink">{copy.preview}</p>
        <p class="mt-2 rounded-xl border border-line bg-gold-soft/30 p-4 text-sm leading-relaxed" data-first-visit-preview></p>
        <p class="mt-3 text-sm text-ink-soft">{copy.editNote}</p>
        <a href={site.whatsapp} class="btn-primary mt-6" target="_blank" rel="noopener noreferrer" data-first-visit-whatsapp>{copy.whatsapp}</a>
      </section>
    </div>

    <div class="mt-7 flex items-center justify-between border-t border-line pt-5">
      <button type="button" class="btn-secondary" data-first-visit-back hidden>{copy.back}</button>
      <button type="button" class="btn-primary ml-auto" data-first-visit-next>{copy.next}</button>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-first-visit-dialog]');

  if (dialog) {
    const steps = Array.from(dialog.querySelectorAll<HTMLElement>('[data-first-visit-step]'));
    const next = dialog.querySelector<HTMLButtonElement>('[data-first-visit-next]')!;
    const back = dialog.querySelector<HTMLButtonElement>('[data-first-visit-back]')!;
    const area = dialog.querySelector<HTMLSelectElement>('[data-first-visit-area]')!;
    const areaLabel = dialog.querySelector<HTMLElement>('[data-first-visit-area-label]')!;
    const error = dialog.querySelector<HTMLElement>('[data-first-visit-error]')!;
    const preview = dialog.querySelector<HTMLElement>('[data-first-visit-preview]')!;
    const whatsapp = dialog.querySelector<HTMLAnchorElement>('[data-first-visit-whatsapp]')!;
    let activeStep = 0;

    const showStep = (index: number) => {
      activeStep = index;
      steps.forEach((step, stepIndex) => { step.hidden = stepIndex !== index; });
      back.hidden = index === 0;
      next.hidden = index === steps.length - 1;
      const progress = dialog.querySelector('.eyebrow');
      if (progress) progress.textContent = `${String(index + 1).padStart(2, '0')} / 04`;
      steps[index]?.querySelector<HTMLElement>('[data-step-heading], select')?.focus();
    };

    const selectedPurpose = () => dialog.querySelector<HTMLInputElement>('[data-first-visit-purpose]:checked');
    dialog.querySelectorAll<HTMLInputElement>('[data-first-visit-purpose]').forEach((choice) => {
      choice.addEventListener('change', () => {
        const wantsArea = choice.value === 'area';
        area.hidden = !wantsArea;
        area.disabled = !wantsArea;
        areaLabel.hidden = !wantsArea;
        error.hidden = true;
      });
    });

    const updateMessage = () => {
      const purpose = selectedPurpose()?.value;
      const topic = area.selectedOptions[0]?.textContent?.trim() ?? '';
      const suffix = purpose === 'area' ? `${dialog.dataset.messageArea} ${topic}.` : dialog.dataset.messageAbout;
      const message = `${dialog.dataset.messageIntro} ${suffix}`;
      preview.textContent = message;
      whatsapp.href = `${dialog.dataset.whatsapp}?text=${encodeURIComponent(message)}`;
    };

    next.addEventListener('click', () => {
      if (activeStep === 1 && (!selectedPurpose() || (selectedPurpose()?.value === 'area' && !area.value))) {
        error.textContent = selectedPurpose()?.value === 'area' ? area.options[0]?.textContent ?? '' : dialog.querySelector('h3')?.textContent ?? '';
        error.hidden = false;
        (selectedPurpose()?.value === 'area' ? area : dialog.querySelector<HTMLInputElement>('[data-first-visit-purpose]'))?.focus();
        return;
      }
      if (activeStep === 2) updateMessage();
      showStep(Math.min(activeStep + 1, steps.length - 1));
    });
    back.addEventListener('click', () => showStep(Math.max(activeStep - 1, 0)));
    dialog.querySelector<HTMLButtonElement>('[data-first-visit-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector<HTMLSelectElement>('[data-first-visit-language]')?.addEventListener('change', (event) => {
      window.location.href = (event.currentTarget as HTMLSelectElement).value;
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      if (window.location.hash === '#primeira-consulta') history.replaceState(null, '', window.location.pathname + window.location.search);
    });
    const openFromHash = () => {
      if (window.location.hash === '#primeira-consulta' && !dialog.open) {
        showStep(0);
        dialog.showModal();
        dialog.querySelector<HTMLSelectElement>('[data-first-visit-language]')?.focus();
      }
    };
    window.addEventListener('hashchange', openFromHash);
    openFromHash();
  }
</script>

<style>
  .first-visit-dialog { position: fixed; inset: 0; margin: auto; width: min(calc(100% - 2rem), 42rem); max-height: min(90dvh, 52rem); overflow-y: auto; }
  .first-visit-dialog::backdrop { background: rgb(30 25 20 / 0.68); backdrop-filter: blur(4px); }
  .first-visit-dialog [hidden] { display: none !important; }
</style>
