---
import { nav, site } from '../data/site';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { careNav, languageNames, localeFromPath, localizedPath, locales, pageFromPath, translations, type PageId } from '../data/i18n';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const locale = localeFromPath(Astro.url.pathname);
const pageId = pageFromPath(Astro.url.pathname) ?? 'home';
const navPages: PageId[] = ['home', 'about', 'specialties', 'approach', 'contact', 'firstVisit'];
const menu = navPages.map((page, index) => ({
  page,
  href: localizedPath(locale, page),
  label: locale === 'pt-BR' ? nav[index].label : translations[locale].nav[index],
}));
const careLinks = careNav.map((item) => ({
  href: localizedPath(locale, item.page),
  label: locale === 'pt-BR' ? item.label : translations[locale].pages[item.page].title,
}));
const ui = locale === 'pt-BR' ? {
  menu: 'Abrir menu', main: 'Principal', book: 'Agendar consulta', language: 'Escolher idioma do site',
} : {
  menu: translations[locale].ui.menu, main: translations[locale].ui.care,
  book: translations[locale].ui.book, language: translations[locale].ui.switchLanguage,
};

function isActive(href: string) {
  const normalized = href.replace(/\/$/, '') || '/';
  return normalized === currentPath;
}

const careActive = careLinks.some((item) => isActive(item.href)) || isActive(localizedPath(locale, 'specialties'));
---

<header class="sticky top-0 z-40 border-b border-line/80 marble-surface backdrop-blur-md" data-site-header>
  <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
  <div class="container-site flex min-h-16 items-center justify-between gap-4 py-3">
    <Logo />

    <nav class="hidden items-center gap-3 xl:flex" aria-label={ui.main}>
      {
        menu.map((item) => item.page === 'specialties' ? (
          <details class="relative" data-nav-item>
            <summary class:list={['link-nav cursor-pointer list-none whitespace-nowrap [&::-webkit-details-marker]:hidden', careActive && 'link-nav-active']}>
              {item.label}
            </summary>
            <div class="absolute left-0 z-50 mt-2 w-72 rounded-2xl border border-line bg-surface p-2 shadow-lg" role="group" aria-label={item.label}>
              <a href={item.href} class:list={['block rounded-lg px-3 py-2 text-sm hover:bg-rose-blush', isActive(item.href) && 'font-semibold text-gold-deep']} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
              {careLinks.map((care) => (
                <a href={care.href} class:list={['block rounded-lg px-3 py-2 text-sm hover:bg-rose-blush', isActive(care.href) && 'font-semibold text-gold-deep']} aria-current={isActive(care.href) ? 'page' : undefined}>
                  {care.label}
                </a>
              ))}
            </div>
          </details>
        ) : (
          <a
            href={item.href}
            class:list={['link-nav whitespace-nowrap', isActive(item.href) && 'link-nav-active']}
            aria-current={isActive(item.href) ? 'page' : undefined}
            data-nav-item
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 md:gap-3">
      <details class="relative" data-nav-item>
        <summary class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-full border border-line bg-surface px-2 text-xs font-semibold text-ink [&::-webkit-details-marker]:hidden" aria-label={`${locale === 'pt-BR' ? 'PT' : locale.toUpperCase()}: ${ui.language}`}>
          {locale === 'pt-BR' ? 'PT' : locale.toUpperCase()}
        </summary>
        <nav class="absolute right-0 z-50 mt-2 w-40 rounded-2xl border border-line bg-surface p-2 shadow-lg" aria-label={ui.language}>
          {locales.map((item) => (
            <a href={localizedPath(item, pageId)} lang={item} hreflang={item} aria-current={item === locale ? 'page' : undefined} class:list={['flex min-h-11 items-center rounded-lg px-3 py-2 text-sm hover:bg-rose-blush', item === locale && 'font-semibold text-gold-deep']}>
              {languageNames[item]}
            </a>
          ))}
        </nav>
      </details>
      <ThemeToggle />

      <a
        href={site.whatsapp}
        class="btn-primary hidden text-sm md:inline-flex"
        target="_blank"
        rel="noopener noreferrer"
        data-header-cta
      >
        {ui.book}
      </a>

      <details class="relative xl:hidden" data-nav-item>
      <summary class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-full border border-line bg-surface/90 backdrop-blur [&::-webkit-details-marker]:hidden">
        <span class="sr-only">{ui.menu}</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </summary>
      <nav class="absolute right-0 mt-2 max-h-[70dvh] w-72 overflow-y-auto rounded-2xl border border-line bg-surface p-3 shadow-lg shadow-ink/10" aria-label={ui.main}>
        {
          menu.map((item) => (
            <a
              href={item.href}
              class:list={[
                'flex min-h-11 items-center rounded-xl px-3 py-2.5 text-sm font-medium',
                isActive(item.href) ? 'bg-gold-soft text-gold-deep' : 'text-ink-soft hover:bg-rose-blush',
              ]}
            >
              {item.label}
            </a>
          ))
        }
        <p class="mt-3 px-3 text-xs font-medium uppercase tracking-[0.16em] text-gold-deep">{locale === 'pt-BR' ? 'Áreas de cuidado' : translations[locale].ui.care}</p>
        {careLinks.map((care) => (
          <a
            href={care.href}
            class:list={[
              'flex min-h-11 items-center rounded-xl px-3 py-2 text-sm',
              isActive(care.href) ? 'bg-gold-soft text-gold-deep' : 'text-ink-soft hover:bg-rose-blush',
            ]}
          >
            {care.label}
          </a>
        ))}
        <a href={site.whatsapp} class="btn-primary mt-2 w-full text-sm" target="_blank" rel="noopener noreferrer">
          WhatsApp
        </a>
      </nav>
    </details>
    </div>
  </div>
</header>
