---
type FaqItem = {
  question: string;
  answer: string;
};

interface Props {
  items: readonly FaqItem[];
  idPrefix?: string;
}

const { items, idPrefix = 'faq' } = Astro.props;
---

<div class="faq-accordion space-y-3">
  {items.map((item, index) => (
    <details class="card-soft overflow-hidden" name={`${idPrefix}-accordion`}>
      <summary id={`${idPrefix}-trigger-${index}`} class="cursor-pointer py-1 text-ink">
        <h3 class="inline font-display text-lg">{item.question}</h3>
      </summary>
      <div id={`${idPrefix}-panel-${index}`} class="faq-panel" role="region" aria-labelledby={`${idPrefix}-trigger-${index}`}>
        <p class="prose-site pb-1 pt-3 text-base">{item.answer}</p>
      </div>
    </details>
  ))}
</div>
