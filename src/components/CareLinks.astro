---
import { careNav, localizedPath } from '../data/i18n';
---

<section class="border-t border-line/70 py-12 md:py-16">
  <div class="container-site max-w-3xl">
    <h2 class="heading-section text-2xl">Áreas de cuidado</h2>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2">
      {
        careNav.map((item) => (
          <li>
            <a href={localizedPath('pt-BR', item.page)} class="card-soft block hover:border-gold/40">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
