---
import { site } from '../data/site';
import Logo from './Logo.astro';
import { careNav, localeFromPath, localizedPath, translations } from '../data/i18n';
const locale = localeFromPath(Astro.url.pathname);
const ui = locale === 'pt-BR' ? null : translations[locale].ui;
const careLinks = careNav.map((item) => ({
  href: localizedPath(locale, item.page),
  label: locale === 'pt-BR' ? item.label : translations[locale].pages[item.page].title,
}));
const emergency: Record<string, string> = {
  'pt-BR': 'Em emergência, ligue 192 (SAMU).',
  en: 'In an emergency, call 192 (SAMU, Brazil).',
  de: 'Im Notfall: 192 (SAMU, Brasilien).',
  it: 'In caso di emergenza, chiama il 192 (SAMU, Brasile).',
  fr: 'En cas d’urgence, appelez le 192 (SAMU, Brésil).',
  es: 'En una emergencia, llame al 192 (SAMU, Brasil).',
};
---

<footer class="relative overflow-hidden border-t border-line bg-brand-cream">
  <div class="pointer-events-none absolute inset-0 opacity-[0.03]" style="background-image:image-set(url('/brand/pattern.webp') type('image/webp'), url('/brand/pattern.png') type('image/png'));background-size:360px auto;" aria-hidden="true"></div>
  <div class="container-site relative grid gap-10 py-12 md:grid-cols-[1.4fr_1fr_1fr] md:py-16">
    <div data-footer-reveal>
      <Logo variant="footer" />
      <p class="mt-4 max-w-md prose-site text-sm">
        {site.fullName} · {locale === 'pt-BR' ? site.specialtyShort : translations[locale].pages.home.title}.
        {locale === 'pt-BR' ? ' Consultório particular no Cristo Rei, Curitiba. Teleconsulta para continuidade na região metropolitana.' : ` ${site.address.neighborhood}, ${site.address.city}.`}
      </p>
      <p class="mt-4 text-sm text-ink-soft">
        {site.crm} · {site.rqe}
      </p>
      <p class="mt-2 text-sm text-ink-soft">{emergency[locale]}</p>
    </div>

    <nav class="text-sm" aria-label={ui?.care ?? 'Áreas de cuidado'} data-footer-reveal>
      <p class="font-medium text-ink">{ui?.care ?? 'Áreas de cuidado'}</p>
      <ul class="mt-3 space-y-2 text-ink-soft">
        <li><a href={localizedPath(locale, 'specialties')} class="hover:text-gold-deep">{ui?.care ?? 'Áreas de cuidado'}</a></li>
        {careLinks.map((item) => (
          <li><a href={item.href} class="hover:text-gold-deep">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="space-y-4 text-sm text-ink-soft" data-footer-reveal>
      <p>
        <span class="block font-medium text-ink">{ui?.address ?? 'Endereço'}</span>
        <a href={localizedPath(locale, 'contact')} class="hover:text-gold-deep">{site.address.full}</a>
      </p>
      <p>
        <span class="block font-medium text-ink">{locale === 'pt-BR' ? 'Contato' : translations[locale].nav[4]}</span>
        <a href={`tel:${site.phoneTel}`} class="hover:text-gold-deep">{site.phone}</a>
        <br />
        <a href={`mailto:${site.email}`} class="hover:text-gold-deep">{site.email}</a>
      </p>
      <p>
        <span class="block font-medium text-ink">{locale === 'pt-BR' ? 'Redes' : 'Instagram'}</span>
        <a href={site.instagram.personal} class="hover:text-gold-deep" target="_blank" rel="noopener noreferrer">
          {site.instagram.personalHandle}
        </a>
        <br />
        <a href={site.instagram.clinic} class="hover:text-gold-deep" target="_blank" rel="noopener noreferrer">
          {site.instagram.clinicHandle}
        </a>
        <br />
        <a href={site.doctoralia} class="hover:text-gold-deep" target="_blank" rel="noopener noreferrer">Doctoralia</a>
        <br />
        <a href={site.linkedin} class="hover:text-gold-deep" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </p>
    </div>
  </div>

  <div class="border-t border-line/80">
    <div class="container-site flex flex-col gap-2 py-6 text-xs text-ink-soft sm:flex-row sm:items-center sm:justify-between" data-footer-reveal>
      <p>© {new Date().getFullYear()} {site.shortName}. {ui?.rights ?? 'Todos os direitos reservados.'}</p>
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <a href={localizedPath(locale, 'firstVisit')} class="hover:text-gold-deep">{locale === 'pt-BR' ? 'Primeira consulta' : translations[locale].nav[5]}</a>
        <span aria-hidden="true">·</span>
        <a href={localizedPath(locale, 'privacy')} class="hover:text-gold-deep">{ui?.privacy ?? 'Privacidade'} (LGPD)</a>
        <span aria-hidden="true">·</span>
        <span>{ui?.disclaimer ?? 'As informações deste site têm caráter informativo e não substituem consulta médica.'}</span>
      </p>
    </div>
  </div>
</footer>
