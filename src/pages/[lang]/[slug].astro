---
import LocalizedPage from '../../components/LocalizedPage.astro';
import OnboardingGuide from '../../components/OnboardingGuide.astro';
import { locales, localizedPath, pageIds, type Locale, type PageId } from '../../data/i18n';

export function getStaticPaths() {
  return locales.filter((locale) => locale !== 'pt-BR').flatMap((lang) =>
    pageIds.filter((page) => page !== 'home').map((page) => ({
      params: { lang, slug: localizedPath(lang, page).split('/')[2] },
      props: { page },
    })),
  );
}

const locale = Astro.params.lang as Exclude<Locale, 'pt-BR'>;
const page = Astro.props.page as PageId;
---

{page === 'firstVisit' ? <OnboardingGuide locale={locale} /> : <LocalizedPage locale={locale} page={page} />}
