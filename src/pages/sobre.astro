---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import BrandPattern from '../components/BrandPattern.astro';
import FormationTimeline from '../components/FormationTimeline.astro';
import DoctoraliaReview from '../components/DoctoraliaReview.astro';
import { site, bio, bioNote, formation, languagesNote, serviceAreaNote } from '../data/site';
import { photos, aboutGallery } from '../data/photos';

const description =
  'Dra. Ligiana Maffini, médica de família em Curitiba (CRM/PR 17731). Consultório no Cristo Rei e teleconsulta quando indicada.';
import CareLinks from '../components/CareLinks.astro';
---

<BaseLayout title="Dra. Ligiana Maffini, médica de família – CRM/PR 17731" description={description} path="/sobre/">
  <section class="hero-glow relative overflow-hidden border-b border-line/70">
    <BrandPattern />
    <div class="container-site relative py-16 md:py-24">
      <p class="eyebrow" data-hero-eyebrow>Sobre</p>
      <h1 class="heading-display mt-3 max-w-3xl" data-hero-title>Dra. Ligiana Maffini</h1>
      <p class="mt-3 max-w-2xl text-sm text-ink-soft" data-hero-subtitle>
        {site.fullName} · {site.crm} · {site.address.neighborhood}, {site.address.city}
      </p>
    </div>
  </section>

  <section class="container-site py-16 md:py-24">
    <div class="grid gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
      <figure class="lg:sticky lg:top-28" data-hero-media>
        <div class="photo-frame">
          <div data-parallax>
            <Photo
              src={photos.goldPortrait}
              alt="Dra. Ligiana Maffini em retrato profissional editorial"
              priority={true}
            />
          </div>
        </div>
      </figure>

      <div data-reveal>
        <p class="prose-site">{bio}</p>
        <p class="prose-site mt-4 text-sm text-ink-soft">{bioNote}</p>
        <p class="prose-site mt-4">
          Consultório particular no bairro Cristo Rei, Curitiba, com consultas longas e
          acompanhamento contínuo em prevenção, saúde da mulher e longevidade.
        </p>
        <p class="prose-site mt-4">{serviceAreaNote}</p>

        <dl class="mt-10 grid gap-4 sm:grid-cols-2">
          <div class="card-soft" data-stagger-item>
            <dt class="text-xs uppercase tracking-widest text-gold-deep">Registro</dt>
            <dd class="mt-2 font-medium text-ink">{site.crm}</dd>
          </div>
          <div class="card-soft" data-stagger-item>
            <dt class="text-xs uppercase tracking-widest text-gold-deep">Registro de especialista</dt>
            <dd class="mt-2 font-medium text-ink">{site.rqe}</dd>
          </div>
          <div class="card-soft sm:col-span-2" data-stagger-item>
            <dt class="text-xs uppercase tracking-widest text-gold-deep">Idiomas</dt>
            <dd class="mt-2 font-medium text-ink">{languagesNote}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section-marble border-y border-line/70 py-16 md:py-24">
    <div class="container-site">
      <p class="eyebrow" data-eyebrow>Formação</p>
      <h2 class="heading-section mt-3 max-w-xl" data-section-title>Trajetória acadêmica e títulos</h2>
      <div class="mt-10 max-w-2xl">
        <FormationTimeline items={formation} />
      </div>
    </div>
  </section>

  <section class="section-rose relative overflow-hidden border-t border-line/70">
    <BrandPattern />
    <div class="container-site relative py-16 md:py-20">
      <p class="eyebrow" data-eyebrow>Na clínica</p>
      <h2 class="heading-section mt-3 max-w-xl" data-section-title>Um ambiente pensado para acolher</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {
          aboutGallery.map((item) => (
            <figure class="photo-frame">
              <Photo src={item.src} alt={item.alt} aspect="square" />
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <DoctoraliaReview />
  <CareLinks />
</BaseLayout>
